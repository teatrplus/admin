{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "cd .. && app/node_modules/.bin/husky",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.503",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tanstack/svelte-query": "^6.1.37",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bits-ui": "^2.18.1",
    "pocketbase": "^0.27.0",
    "svelte-dnd-action": "^0.9.74",
    "valibot": "^1.4.2"
  }
}
